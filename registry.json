{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "joro-ui",
  "homepage": "https://joro-ui.vercel.app",
  "items": [
    {
      "name": "theme-toggle",
      "type": "registry:component",
      "title": "Theme Toggle",
      "description": "Smooth View Transitions API theme toggle with circular clip-path reveal and arc motion.",
      "dependencies": [
        "lucide-react",
        "next-themes",
        "framer-motion"
      ],
      "registryDependencies": [
        "button"
      ],
      "files": [
        {
          "path": "registry/theme-toggle/index.ts",
          "type": "registry:component",
          "target": "components/ui/custom/theme-toggle/index.ts"
        },
        {
          "path": "registry/theme-toggle/theme-toggle.tsx",
          "type": "registry:component",
          "target": "components/ui/custom/theme-toggle/theme-toggle.tsx"
        },
        {
          "path": "registry/theme-toggle/use-view-transition-theme.ts",
          "type": "registry:hook",
          "target": "components/ui/custom/theme-toggle/use-view-transition-theme.ts"
        }
      ]
    },
    {
      "name": "multi-filter-dropdown",
      "type": "registry:component",
      "title": "Multi-Filter Dropdown",
      "description": "Grid-friendly square card multi-select popover with stacked badge preview, emojis, search, and clear trigger.",
      "dependencies": [
        "lucide-react"
      ],
      "registryDependencies": [
        "button",
        "popover",
        "command"
      ],
      "files": [
        {
          "path": "registry/multi-filter-dropdown/index.ts",
          "type": "registry:component",
          "target": "components/ui/custom/multi-filter-dropdown/index.ts"
        },
        {
          "path": "registry/multi-filter-dropdown/multi-filter-dropdown.tsx",
          "type": "registry:component",
          "target": "components/ui/custom/multi-filter-dropdown/multi-filter-dropdown.tsx"
        },
        {
          "path": "registry/multi-filter-dropdown/use-multi-filter.ts",
          "type": "registry:hook",
          "target": "components/ui/custom/multi-filter-dropdown/use-multi-filter.ts"
        }
      ]
    }
  ]
}
